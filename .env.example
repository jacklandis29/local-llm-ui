# LM Studio API Configuration
# Change this if your LM Studio server is running on a different host/port
REACT_APP_API_URL=http://localhost:1234

# Optional: Specify model name (useful for vision models or when multiple models are loaded)
# Leave empty to use whatever model is loaded in LM Studio
# Example: REACT_APP_MODEL_NAME=qwen/qwen3-vl-8b:4
REACT_APP_MODEL_NAME=
